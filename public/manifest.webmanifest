{
  "name": "Pokemon Champions Strategy Companion",
  "short_name": "Champions",
  "description": "Assistant local-first pour preparer une equipe Pokemon Champions avec les tiers Pokemon Showdown Champions.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7fbff",
  "theme_color": "#17324d",
  "categories": ["games", "utilities"],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "./icons/apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Preparer une team",
      "short_name": "Team",
      "url": "./app",
      "description": "Ouvrir la vue mobile Pokemon Champions"
    }
  ]
}
